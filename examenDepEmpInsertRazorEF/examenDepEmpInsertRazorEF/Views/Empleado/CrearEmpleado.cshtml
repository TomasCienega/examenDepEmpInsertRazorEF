@{
    ViewData["Title"] = "Empleados";
}
@model examenDepEmpInsertRazorEF.Models.Empleado

<div class="container mt-4">
    <h2>Registrar Nuevo Empleado</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="CrearEmpleado" method="post">
                <div class="form-group mb-3">
                    <label class="form-label">Nombre del Empleado</label>
                    <input asp-for="NombreEmpleado" class="form-control" placeholder="Ej. Juan Pérez" />
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Departamento</label>
                    <select asp-for="IdDepartamento" class="form-control"
                            asp-items="@(new SelectList(ViewBag.ListaDeptos, "IdDepartamento", "NombreDepartamento"))">
                        <option value="">-- Selecciona un departamento --</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">Guardar Registro</button>
                <a asp-action="Index" class="btn btn-secondary">Regresar al Listado</a>
            </form>
        </div>
    </div>
</div>